{
  "$defs": {
    "Adjudication": {
      "additionalProperties": false,
      "description": "One human decision on one finding of a routed image (reviewer work order A7).\n\n``accept`` / ``reject`` / ``reclassify`` act on a model candidate; ``add_box`` draws a\nmissing object; ``class_absent`` confirms a suspected class is not there; ``complete``\ncloses the image once its findings are decided. ``decided_at`` is supplied by the caller\n(no hidden clock). ``id`` is derived from the content, so an edited line no longer verifies.",
      "properties": {
        "box_xyxy": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box Xyxy"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "class_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "decided_at": {
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "reclassify",
            "add_box",
            "class_absent",
            "complete"
          ],
          "title": "Decision",
          "type": "string"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "human",
          "default": "human",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "image_id",
        "decision",
        "reviewer",
        "decided_at"
      ],
      "title": "Adjudication",
      "type": "object"
    },
    "AnnotationAudit": {
      "additionalProperties": false,
      "properties": {
        "established_by": {
          "default": "none",
          "enum": [
            "human",
            "calibrated_audit_policy",
            "none"
          ],
          "title": "Established By",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reviewer_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Outcome"
        },
        "status": {
          "enum": [
            "complete",
            "needs_review",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "suspected_missing_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suspected Missing Classes",
          "type": "array"
        },
        "unmatched_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unmatched Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "AnnotationAudit",
      "type": "object"
    },
    "ClassSpec": {
      "additionalProperties": false,
      "description": "One project-defined class. ``class_id`` is free text; no public taxonomy is assumed.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "class_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.\\-]+$",
          "title": "Class Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "negative_prompts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Negative Prompts",
          "type": "array"
        },
        "positive_prompts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Positive Prompts",
          "type": "array"
        }
      },
      "required": [
        "class_id",
        "display_name",
        "positive_prompts"
      ],
      "title": "ClassSpec",
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "box_xyxy": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box Xyxy",
          "type": "array"
        },
        "class_id": {
          "title": "Class Id",
          "type": "string"
        },
        "coord_system": {
          "const": "xyxy_pixel_original",
          "default": "xyxy_pixel_original",
          "title": "Coord System",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "raw_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Confidence"
        },
        "slice_origin": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slice Origin"
        },
        "source": {
          "enum": [
            "primary",
            "secondary",
            "sahi",
            "human"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "class_id",
        "box_xyxy",
        "source",
        "model_version"
      ],
      "title": "Detection",
      "type": "object"
    },
    "FinalCandidate": {
      "additionalProperties": false,
      "properties": {
        "box_xyxy": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box Xyxy",
          "type": "array"
        },
        "canonical_source_id": {
          "title": "Canonical Source Id",
          "type": "string"
        },
        "class_id": {
          "title": "Class Id",
          "type": "string"
        },
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "accepted",
            "candidate",
            "needs_review",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "class_id",
        "box_xyxy",
        "status",
        "source_ids",
        "canonical_source_id"
      ],
      "title": "FinalCandidate",
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "uri",
        "width",
        "height",
        "sha256"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "classes": {
          "items": {
            "$ref": "#/$defs/ClassSpec"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "prompt_set_version": {
          "minLength": 1,
          "title": "Prompt Set Version",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "prompt_set_version",
        "classes"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "description": "Constrained VLM output. Has no box field by design: a VLM cannot author boxes.",
      "properties": {
        "candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "class_id": {
          "title": "Class Id",
          "type": "string"
        },
        "model_note": {
          "default": "",
          "maxLength": 200,
          "title": "Model Note",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "region_xyxy": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Xyxy"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "present",
            "absent",
            "uncertain"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "class_id",
        "verdict",
        "reason_code",
        "model_version"
      ],
      "title": "VerificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A routed image after human adjudication.\n\nModel suggestions stay in the base RouteRecord (``record_id``); human-drawn boxes are\n``human_detections`` with source \"human\"; ``final_candidates`` and ``completeness`` are the\nreviewed state.",
  "properties": {
    "adjudications": {
      "items": {
        "$ref": "#/$defs/Adjudication"
      },
      "title": "Adjudications",
      "type": "array"
    },
    "completeness": {
      "$ref": "#/$defs/AnnotationAudit"
    },
    "final_candidates": {
      "items": {
        "$ref": "#/$defs/FinalCandidate"
      },
      "title": "Final Candidates",
      "type": "array"
    },
    "human_detections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "title": "Human Detections",
      "type": "array"
    },
    "image": {
      "$ref": "#/$defs/ImageRef"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    }
  },
  "required": [
    "record_id",
    "image",
    "task",
    "adjudications",
    "final_candidates",
    "completeness"
  ],
  "title": "ReviewedRecord",
  "type": "object"
}
